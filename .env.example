# Copia este fichero a .env SOLO si aún no tienes uno. Nunca subas .env a Git.
# Rellena las claves de los proveedores que vayas a usar; las vacías no dan acceso.
# Tras cambiar .env: docker compose up -d --force-recreate litellm
# Un simple restart no actualiza las variables de entorno del contenedor.

# LiteLLM: genera dos secretos independientes (por ejemplo: openssl rand -hex 32).
# La master key debe comenzar por sk-. Sustituye estos valores antes de arrancar.
LITELLM_MASTER_KEY=sk-REEMPLAZAR_POR_UN_SECRETO_ALEATORIO
# No rotar la salt key una vez haya credenciales cifradas en la base de datos.
LITELLM_SALT_KEY=REEMPLAZAR_POR_OTRO_SECRETO_ALEATORIO
# DATABASE_URL la proporciona docker-compose.yml; no hace falta definirla aquí.

# Puerto que el proxy expone en el host (dentro del contenedor siempre 4000).
LITELLM_PORT=4000

# OpenRouter: https://openrouter.ai/settings/keys
# Solo los modelos/rutas gratuitos tienen cuota free; auto y Claude pueden cobrar.
# openrouter-free usa openrouter/free (router gratuito); los alias acabados en
# -free fijan un modelo :free. Todos usan esta misma key y están sujetos a cuotas.
# Catálogo actual: https://openrouter.ai/api/v1/models
OPENROUTER_API_KEY=

# Ollama Cloud: https://ollama.com/settings/keys
# Disponibilidad y cuotas según el plan de la cuenta.
OLLAMA_CLOUD_API_BASE=https://ollama.com/v1
OLLAMA_CLOUD_API_KEY=

# Ollama local (sin key: endpoint sin autenticación).
# host.docker.internal llega al host desde Docker Desktop (Mac/Windows).
# En Linux, usa http://172.17.0.1:11434 o añade extra_hosts en compose.
OLLAMA_LOCAL_API_BASE=http://host.docker.internal:11434

# LM Studio local (servidor OpenAI-compatible, por defecto puerto 1234).
# Actívalo en Developer > Start server. La key no se verifica: cualquier
# valor vale, pero debe existir la variable porque config.yaml la referencia.
LM_STUDIO_API_BASE=http://host.docker.internal:1234/v1
LM_STUDIO_API_KEY=lm-studio

# Google AI Studio: https://aistudio.google.com/apikey
# Free tier según modelo, región y cuenta; no equivale a uso gratuito ilimitado.
GEMINI_API_KEY=

# Groq: https://console.groq.com/keys
# Free Plan: https://console.groq.com/docs/rate-limits
# GPT-OSS 120B y 20B comparten las restricciones de la organización.
# Una cuenta de pago puede generar cargos con estos mismos modelos.
GROQ_API_KEY=

# Cloudflare Workers AI: https://dash.cloudflare.com/
# Crea un API token con permiso Account / Workers AI / Edit para tu cuenta.
# CLOUDFLARE_API_KEY es ese token, no la Global API Key.
# Copia también el Account ID del panel (no el Zone ID).
# Workers Free incluye 10.000 neuronas diarias compartidas entre los modelos.
# En Workers Paid, el consumo que supere la cuota gratuita se factura.
# https://developers.cloudflare.com/workers-ai/platform/pricing/
CLOUDFLARE_API_KEY=
CLOUDFLARE_ACCOUNT_ID=

# AnyAPI.ai: https://dash.anyapi.ai/ (crea aquí tu API key).
# API compatible con OpenAI: https://docs.anyapi.ai/get-started/quick-start
# Los alias anyapi-*-free usan IDs con precio 0 en sus fichas públicas.
# Qwen Coder tiene ID sin :free, aunque su ficha lo anuncia como gratuito.
# Confirma disponibilidad, cuotas y tarifas en tu cuenta antes de usarlo.
# El crédito de prueba del plan es distinto de los modelos de precio 0.
ANY_API_BASE=https://api.anyapi.ai/v1
ANY_API_KEY=
